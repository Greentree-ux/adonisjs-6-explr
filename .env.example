# Process timezone. Keep this UTC: all 78 timestamptz columns then flow as
# unambiguous instants, and logs are readable against any deployment. Note this
# is the PROCESS timezone, not the business one — see APP_TIMEZONE below.
# In production set TZ in the container environment rather than relying on this
# file: Node reads process.env.TZ at startup, and .env is loaded afterwards.
TZ=UTC

# Business timezone, used to anchor calendar dates (joining dates, action-plan
# milestones) to real instants. Validated at boot against the IANA database, so
# a typo fails immediately rather than silently becoming UTC and shifting every
# reminder. Defaults to Asia/Kolkata. When users span timezones this becomes the
# per-user default rather than a global value.
APP_TIMEZONE=Asia/Kolkata

# Hour of day (0-23, local to APP_TIMEZONE) at which date-derived reminders are
# sent. Without it reminders land at midnight, which nobody chose.
REMINDER_SEND_HOUR=9

# Service name, used as the logger's "name" field.
APP_NAME=AdonisJSApp

PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

# Public base URL of this application, used to build the links in invitation,
# password-reset and onboarding emails. Optional in development, where it
# defaults to http://localhost:3333. REQUIRED in production — the app refuses
# to boot without it, rather than emailing localhost links to real employees.
# Must be an absolute http/https URL; a trailing slash is stripped.
APP_URL=
SESSION_DRIVER=cookie

# Peer addresses whose X-Forwarded-* headers may be trusted. Defaults to
# "loopback", which is correct when nothing sits in front of the app. Behind a
# reverse proxy running as a separate container the peer is a private network
# address, so set "loopback,uniquelocal" or the proxy's exact address/CIDR —
# otherwise request.ip() logs the proxy instead of the real client.
# Accepts a comma-separated list of loopback | linklocal | uniquelocal | IP | CIDR.
TRUST_PROXY=

# DB_CONNECTION is deliberately absent: config/database.ts hardcodes
# connection: 'postgres', so the variable that used to sit here had no effect
# and only invited someone to set "mysql" and wonder why nothing changed.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=
SMTP_HOST=
SMTP_PORT=

# SMTP authentication. Leave both blank for local Mailpit on localhost:1025,
# which accepts unauthenticated mail. Set BOTH for any real relay — setting
# only the username refuses to boot, since it would otherwise fail at send
# time and silently drop mail the app believes it delivered.
SMTP_USERNAME=
SMTP_PASSWORD=

# Sender identity. Both optional; the code falls back to
# noreply@example.com / "AdonisJS App", which is fine for Mailpit. A real relay
# will reject an unverified sender domain, so production must set these —
# see .env.production.example.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

REMINDER_WORKER_ENABLED=true