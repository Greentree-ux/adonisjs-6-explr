# ---------------------------------------------------------------------------
# Production environment template
#
# Copy to .env ON THE SERVER ONLY and fill in the blanks. Never commit the
# filled-in file, and never bake it into a Docker image — an image layer keeps
# a file even if a later step deletes it (see .dockerignore, T2.3).
#
#   umask 077 && cp .env.production.example .env    # 0600 from the start
#
# Every variable that start/env.ts validates appears below. Blank values are
# ones you must supply; anything with a value is a deliberate production
# default. The app refuses to boot if a required variable is missing, so a
# half-filled file fails immediately rather than at 3am.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# Service name, used as the logger's "name" field. Set it to something
# identifiable in aggregated logs, especially if more than one service ships
# to the same destination.
APP_NAME=fcm-competency

NODE_ENV=production

# 0.0.0.0, not localhost. A container that binds to localhost accepts no
# traffic from outside itself, which presents as a reverse proxy returning 502
# with nothing wrong in the app's own logs.
HOST=0.0.0.0
PORT=3333

# info is the intended production level. Note LOG_LEVEL=debug will fill the
# disk over time unless log rotation is configured (T7.3).
LOG_LEVEL=info

# Process timezone. Keep UTC so instants and log lines are unambiguous across
# deployments. Set this in the container environment as well, not only here:
# Node reads process.env.TZ at startup and .env is loaded afterwards, so
# relying on this file alone is platform-dependent.
TZ=UTC

# --- Secrets ---------------------------------------------------------------

# REQUIRED. Generate a fresh one for this deployment and never reuse the
# development key — sessions, signed URLs and remember-me tokens are all
# derived from it, so a shared key means anyone with the dev key can forge a
# production session.
#
#   node ace generate:key --show
#
# Changing it later invalidates every active session and every unexpired
# password-reset link.
APP_KEY=

# --- Database --------------------------------------------------------------
#
# PostgreSQL 16. The major version is pinned deliberately: pg-boss has already
# created its "pgboss" schema at 16, and a different major puts its internal
# migrations on a different path.
#
# Use a dedicated non-superuser role that owns only this database.

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# --- Sessions --------------------------------------------------------------

SESSION_DRIVER=cookie

# --- Reverse proxy ---------------------------------------------------------
#
# Peer addresses whose X-Forwarded-* headers may be trusted. Defaults to
# "loopback", which is WRONG once a proxy runs as a separate container: the peer
# is then a private network address, so the real client IP never reaches the
# application logs.
#
# "uniquelocal" covers the RFC1918 ranges Docker networks use. A comma-separated
# list, an explicit address or a CIDR block all work.
TRUST_PROXY=loopback,uniquelocal

# --- Public URL ------------------------------------------------------------
#
# REQUIRED in production — the app refuses to boot without it. Invitation,
# password-reset and onboarding emails build their links from this value, and
# without it they would point at http://localhost:3333 and reach nobody.
#
# Absolute http/https URL, no trailing slash (one is stripped if present).
APP_URL=

# --- Mail ------------------------------------------------------------------
#
# A real relay, not Mailpit. This application sends invitations, password
# resets and reminders, so mail is not optional.

SMTP_HOST=
SMTP_PORT=587

# Set BOTH or NEITHER. A username without a password refuses to boot, because
# the alternative is failing at send time — the app would believe it had
# delivered invitations that never left.
SMTP_USERNAME=
SMTP_PASSWORD=

# Use an address on a domain the relay has verified. The code falls back to
# noreply@example.com, which real relays reject as an unverified sender — and
# the resulting bounce looks like a credentials problem rather than a from
# address problem.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# --- Reminders -------------------------------------------------------------
#
# The pg-boss worker runs in-process via bin/server.ts. The deployed topology
# is ONE application instance with the worker enabled, so leave this true.
#
# Accepts only "true" or "false"; anything else refuses to boot. It used to be
# compared with != "false", so "FALSE", "0" and "no" all quietly enabled the
# worker.
#
# Setting it false does NOT make a process a non-worker: it only skips the
# startup at boot, and the enqueue path starts a worker lazily on the first
# reminder written. Do not plan a web/worker split around this flag without
# reading the "Background jobs" section of the README first.
REMINDER_WORKER_ENABLED=true

# Business timezone, distinct from TZ above. Used to anchor calendar dates
# (joining dates, action-plan milestones) to real instants. Validated against
# the IANA database at boot, so a typo fails immediately instead of silently
# becoming UTC and shifting every reminder.
APP_TIMEZONE=Asia/Kolkata

# Hour of day (0-23) local to APP_TIMEZONE at which date-derived reminders are
# sent.
REMINDER_SEND_HOUR=9
